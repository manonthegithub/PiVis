[Unit]
Description=PiVis — camera streaming + people detection + greeting
After=network.target

[Service]
Type=simple
User=repka
WorkingDirectory=/home/repka/pivis
EnvironmentFile=/home/repka/pivis/.env
ExecStart=/home/repka/pivis/.venv/bin/python -m pivis
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
