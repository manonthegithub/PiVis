# Required
ANTHROPIC_API_KEY=your_key_here

# Camera
STREAM_FPS=20
CAMERA_WIDTH=1280\nCAMERA_HEIGHT=720

# Detection
DETECTION_INTERVAL_MS=200
DETECTION_CONFIDENCE=0.5
YOLO_MODEL_PATH=models/yolov8n.onnx

# Greeting
GREETING_COOLDOWN_S=30
CLAUDE_MODEL=claude-haiku-4-5-20251001

# TTS
TTS_VOICE_PATH=models/en_US-lessac-medium.onnx
PIPER_BINARY=piper

# Audio output: browser | local | both
AUDIO_OUTPUT=both
AUDIO_DEVICE=default

# Standalone audio module (browser mic -> STT), deployed separately in k8s
# (see k8s/audio/ and README's "Audio module" section). Leave unset to
# disable the mic-transcription UI in the main app.
# AUDIO_SERVER_WS_URL=wss://pivis-aud.apps.arpa
