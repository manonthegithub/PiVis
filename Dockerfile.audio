# Standalone image for the audio module only (pivis/audio_app.py) — no
# camera/vision dependencies, runs on any arch including the arm64 k3s
# cluster this is deployed to.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /usr/sbin/nologin appuser

WORKDIR /app

COPY requirements-audio.txt .
RUN pip install --no-cache-dir -r requirements-audio.txt

COPY pivis/__init__.py pivis/__init__.py
COPY pivis/audio_app.py pivis/audio_app.py
COPY pivis/audio pivis/audio
COPY pivis/web/static pivis/web/static

# Bake the Whisper model into the image at build time so pods don't need
# network access on startup. Downloaded as appuser so the cache lands in
# its home dir, matching where the app loads it from at runtime.
ARG WHISPER_MODEL=tiny
ENV WHISPER_MODEL=${WHISPER_MODEL}
RUN chown -R appuser:appuser /app
USER appuser
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('${WHISPER_MODEL}', device='cpu', compute_type='int8')"

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD curl -f http://localhost:8000/healthz || exit 1

CMD ["uvicorn", "pivis.audio_app:app", "--host", "0.0.0.0", "--port", "8000"]
