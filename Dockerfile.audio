# Standalone image for the audio module only (pivis/audio_app.py) — no
# camera/vision dependencies, runs on any arch including the arm64 k3s
# cluster this is deployed to.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /usr/sbin/nologin appuser

WORKDIR /app

COPY requirements-audio.txt .
RUN pip install --no-cache-dir -r requirements-audio.txt

COPY pivis/__init__.py pivis/__init__.py
COPY pivis/audio_app.py pivis/audio_app.py
COPY pivis/audio pivis/audio
COPY pivis/web/static pivis/web/static

# Bake every model size in WHISPER_MODELS_TO_BAKE into the image at build
# time so pods don't need network access on startup -- and so switching
# which one runs is just editing WHISPER_MODEL in
# k8s/audio/configmap.yaml + `kubectl rollout restart`, not a rebuild.
# HF_HUB_OFFLINE=1 below means only sizes baked in here are usable; add to
# this list (and rebuild once) before pointing the ConfigMap at a new size.
# Downloaded as appuser so the cache lands in its home dir, matching where
# the app loads it from at runtime.
ARG WHISPER_MODELS_TO_BAKE="tiny base small"
RUN chown -R appuser:appuser /app
USER appuser
RUN for m in ${WHISPER_MODELS_TO_BAKE}; do \
        python -c "from faster_whisper import WhisperModel; WhisperModel('$m', device='cpu', compute_type='int8')"; \
    done

# Set only after the bake step (which needs network to actually download the
# model) -- confirmed live: without this, the model is baked in but
# huggingface_hub still makes a live revision-check API call on every pod
# startup, undermining the "no network needed at startup" point of baking
# it in, and turning a HF outage into a pod-start failure.
ENV HF_HUB_OFFLINE=1

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD curl -f http://localhost:8000/healthz || exit 1

CMD ["uvicorn", "pivis.audio_app:app", "--host", "0.0.0.0", "--port", "8000"]
